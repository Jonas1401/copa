# CopaLinks — variáveis de ambiente reais usadas pelo código (confirmadas no src/)
#
# NENHUM valor secreto deve ser commitado. Preencha apenas na Vercel
# (Settings → Environment Variables) ou num arquivo .env local (não versionado).

# --- OBRIGATÓRIA -------------------------------------------------------------
# Conexão PostgreSQL. Aceita também POSTGRES_URL / POSTGRES_PRISMA_URL (Vercel/Neon).
# Exemplo (Supabase, Transaction pooler — porta 6543, o mais indicado para a Vercel):
#   postgresql://postgres.SEU-PROJECT-REF:SUA-SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Copie a sua no painel do Supabase (botão Connect) — a região no endereço pode ser outra.
DATABASE_URL=

# --- RECOMENDADAS EM PRODUÇÃO ------------------------------------------------
# Protege o /api/cron (Vercel Cron envia Authorization: Bearer <CRON_SECRET>).
# Sem ela, o /api/cron fica ABERTO a qualquer um. Gere um valor longo e aleatório.
CRON_SECRET=

# Opcional: segunda chave para o agendador do Supabase (pg_cron + pg_net).
# Usada somente pelo /api/cron; guarde o valor no Supabase Vault, nunca no GitHub.
# A chave é independente do CRON_SECRET da Vercel para não interromper o cron atual.
SUPABASE_CRON_SECRET=

# Código de uso único para criar o PRIMEIRO administrador em /admin (8+ chars).
ADMIN_SETUP_CODE=

# Opcional: cria o usuário "admin" automaticamente na 1ª subida (8+ chars).
ADMIN_PASSWORD=

# Chave mestra do cofre de API Keys do painel (16+ chars). Se omitida, o app
# gera uma e guarda dentro do banco (menos ideal). Defina-a em produção.
SECRETS_MASTER_KEY=

# --- OPCIONAIS ---------------------------------------------------------------
# Endereço público fixo para links de compartilhar. Se omitido, a Vercel fornece VERCEL_URL.
SITE_URL=

# Chaves VAPID de notificação. Se omitidas, o app gera e guarda no banco.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:monitor@copalinks.app

# URL do site monitorado. Padrão: https://intranet.copadubo.com.br/ponto/
INTRANET_URL=

# Token da APPA/SIMPORT (tempo). O painel público já envia este token, então é
# de baixo risco, mas pode ser sobrescrito por variável.
SIMPORT_AUTH_TOKEN=

# Chave do Composio (IA do chat + leitura de reserva + clima). Normalmente
# cadastrada no /admin e cifrada no banco; também pode vir de variável com este nome.
# A IA usa primeiro o Google Gemini pelo Composio (modo sem login, só com esta
# chave). Reserva opcional: conta OpenAI conectada no dashboard do Composio
# (Apps → OpenAI → Connect) com o mesmo projeto desta chave.
COMPOSIO_API_KEY=

# Monitor WhatsApp no Android (apenas no servidor da Vercel; JSON da conta de serviço do Firebase).
# Obrigatória para parear receptores e enviar avisos FCM; NÃO colocar no GitHub ou no APK.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- RADAR DA PREVISÃO (monitoramento constante do tempo) --------------------
# O /api/cron compara a leitura atual do SIMPORT®/APPA com a do último aviso e
# manda para o chat + Web Push (chega com o app fechado) só a mudança que
# importa: vento, condição do tempo, alerta, boletim e a VIRADA da situação da
# chuva (sem chuva → chuva, ou chuva → tempo limpo). Enquanto a situação da
# chuva não vira, as oscilações de probabilidade/volume ficam registradas sem
# notificação (anti-spam; a situação notificada fica gravada no banco).
# Temperatura, maré e horário do sol apenas atualizam a referência, sem
# notificação.
# Todos opcionais; os valores abaixo já são os padrões.
# Desligar o radar: 0 (ou off/false/desligado).
CLIMA_MONITOR_ATIVO=1
# De quanto em quanto tempo a previsão é relida (minutos).
CLIMA_MONITOR_MIN=5
# De quanto em quanto tempo o painel da APPA é relido (minutos).
CLIMA_MONITOR_PAINEL_MIN=5
# Quanto o número precisa mudar para virar aviso: baixa | media | alta.
CLIMA_MONITOR_SENSIBILIDADE=media
# --- COTA DE NOTIFICAÇÕES (o antiexcesso dos agentes do chat) ----------------
# Clima, radar e navios passam pela cota comum (src/lib/notificacoes-cota.ts):
# intervalo mínimo entre avisos, teto por hora e teto por dia (horário de
# Brasília). Mudança GRAVE (temporal, rajada forte, navio atracou/saiu) passa
# do teto, mas nunca sai em cima do aviso anterior (piso de 15 min).
#
# Radar da previsão — intervalo mínimo entre avisos (minutos).
CLIMA_MONITOR_AVISO_MIN=45
# Teto de avisos do radar por hora.
CLIMA_MONITOR_MAX_HORA=2
# Teto de avisos do radar por dia.
CLIMA_MONITOR_MAX_DIA=8
# Piso entre dois avisos GRAVES do radar (minutos).
CLIMA_MONITOR_MIN_GRAVE=15
# Alerta de tempo ruim (🌦️ Clima no Porto): o nível novo é urgente; o lembrete
# em alerta ativo respeita o intervalo e o teto por dia abaixo.
CLIMA_ALERTA_MIN=360
CLIMA_ALERTA_MAX_HORA=1
CLIMA_ALERTA_MAX_DIA=4
# Boletim de previsão do turno: o Push só sai quando o turno traz novidade
# (chuva, vento forte, frio/calor fora do normal ou previsão revisada). Nos
# turnos tranquilos, o aparelho recebe um boletim no máximo a cada N minutos.
CLIMA_BOLETIM_PUSH_MIN=720
# Navios de fertilizantes — cota dos avisos (minutos / por hora / por dia).
NAVIOS_AVISO_MIN=20
NAVIOS_MAX_HORA=3
NAVIOS_MAX_DIA=8
# Mudança mínima na previsão de atracação (ETB) para virar aviso (minutos).
# Derivas menores que isso não notificam; a comparação é sempre contra a
# última previsão NOTIFICADA, então a deriva acumulada ainda é avisada.
NAVIOS_ETB_DELTA_MIN=120
# --- LEITURA DO PAINEL DA APPA (fallback automático) -------------------------
# O radar lê o painel público tentando, nesta ordem: API/JSON embutido →
# HTTP + HTML → navegador headless (Playwright/Puppeteer) → captura de tela +
# OCR → Composio. Se um método falha, o próximo entra sozinho. Nada aqui é
# obrigatório: sem as variáveis valem os padrões abaixo.
# Endereço do painel (o mesmo que o motorista abre no navegador).
# SIMPORT_PAINEL_URL=https://weather-appa.app.simport.com.br/
# API estruturada que alimenta o painel (WRF + estação do porto + boletim).
# APPA_DADOS_API=https://appa.cs.simport.com.br/api/v2/data
# APPA_BOLETIM_API=https://wfa.app.simport.com.br/api/calendar
# Token que o painel público já envia a qualquer visitante (só no servidor).
# SIMPORT_AUTH_TOKEN=

# Navegador headless: módulo npm tentado (padrão: playwright, playwright-core,
# puppeteer, puppeteer-core) e/ou navegador externo por CDP. No servidor
# serverless (Vercel), aponte APPA_CDP_URL para um navegador remoto
# (browserless, Chrome headless em outro serviço...) — sem isso, os métodos de
# navegador/OCR são pulados e o radar segue com API, HTML e Composio.
# APPA_NAVEGADOR_MODULO=playwright
# APPA_CDP_URL=
# Tempo máximo da leitura HTTP e do navegador headless (ms).
# APPA_LEITURA_TIMEOUT_MS=20000
# APPA_NAVEGADOR_TIMEOUT_MS=45000

# OCR da captura de tela: serviço externo (recebe um POST image/png e devolve
# JSON {texto} ou texto puro). Sem ele, o OCR usa o tesseract.js, o mesmo leitor
# da foto do ticket em Cálculo de Frete.
# APPA_OCR_URL=
# APPA_OCR_IDIOMA=por+eng

# Reserva da IA quando o Composio não tem conta OpenAI conectada. Normalmente
# cadastrada no /admin; aceita OpenAI, Anthropic, Gemini, Groq ou OpenRouter.
AI_API_KEY=
AI_PROVIDER=auto

# Filtro do grupo SEM APK (opcionais). O endereço do webhook normalmente é
# gerado no painel /monitor (o segredo fica só como hash no banco). Use estas
# variáveis apenas se preferir fixar o segredo e/ou o ID do grupo na Vercel.
# WHATSAPP_WEBHOOK_SECRET: 16+ caracteres aleatórios, enviado pelo serviço de
#   WhatsApp Web como Authorization: Bearer <valor> (ou ?token=<valor>).
# WHATSAPP_GRUPO_ID: ID do grupo (ex.: 120363000000000000@g.us); com ele,
#   só esse ID é aceito (necessário para Evolution API/WAHA, que não enviam o nome).
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_GRUPO_ID=

# --- INTERNET / eSIM — NexaEsim ---------------------------------------------
# Nunca exponha estas variáveis em NEXT_PUBLIC_*, no app, nem nos logs.
# Modo padrão: TESTE local (sem chamadas à NexaEsim e sem cobranças).
# A documentação pública Partner API v1 encontrada publica apenas produção;
# não informa URL/procedimento de sandbox. Só mude para PRODUCTION após validar
# acesso e IP allowlist com a NexaEsim e configurar os secrets no backend.
NEXAESIM_MODE=TEST
NEXAESIM_API_KEY=
NEXAESIM_API_URL=https://nexaesim.com/api/partner/v1
NEXAESIM_WEBHOOK_SECRET=

# O repositório não possui um gateway Pix/cartão configurado. Variável usada
# pelo contrato assinado do callback de pagamento (adaptador do gateway pendente).
ESIM_PAYMENT_WEBHOOK_SECRET=
